/*
 * Board device tree for the AES RK3506B board (RK3506B SoC, arm32 Cortex-A7).
 * Mainline bring-up: minimal board for earlycon/console on uart0.
 */

/dts-v1/;

#include "rk3506.dtsi"

/ {
	model = "AES RK3506B Board";
	compatible = "aes,rk3506b-aes", "rockchip,rk3506b", "rockchip,rk3506";

	chosen {
		stdout-path = "serial0:1500000n8";
		/* Mount the NAND rootfs (UBI volume "rootfs" on mtd5 — the 6th fixed
		 * partition in the SFC node below) as root; rootwait lets UBI attach
		 * first. `rw` mounts it read-write so writes persist (without it the
		 * kernel mounts the initial root read-only). Harmless for the
		 * initramfs-shell boot variant: if the boot FIT also bundles an
		 * initramfs with /init, the kernel runs that /init and ignores root=. */
		bootargs = "earlycon=uart8250,mmio32,0xff0a0000 console=ttyS0,1500000 ubi.mtd=5 root=ubi0:rootfs rootfstype=ubifs rootwait rw";
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x20000000>;	/* 512 MiB; DRAM base 0x0 (CFG_SYS_SDRAM_BASE=0) */
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/* OP-TEE / trust resident memory. The loader (rkbin TOS, ADDR=0x1000)
		 * pins OP-TEE in low DRAM [0x1000, ~0x61000]. Without this carve-out the
		 * kernel adds those physical pages to the free pool and hands them to
		 * user space; the secure world then rejects the access as a precise
		 * external abort (0x008) — reproducible under any sustained alloc churn
		 * (dd to tmpfs, not just NAND I/O), the root cause of the write-stress
		 * abort saga. Mirrors the vendor rk3506 DT's trust@0 reservation. */
		trust@0 {
			reg = <0x0 0x62000>;
		};
	};
};

&uart0 {
	status = "okay";
};

/*
 * Ethernet — DUAL RJ45 on the AES board (ATK has both gmac0 + gmac1, each with
 * a YT8512 PHY). Mainline dwmac-rk has full rk3506 RMII glue. The board's two
 * ports: gmac0 reset on GPIO0_PA0, gmac1 reset on GPIO0_PC4 (both active-low);
 * each PHY is a generic C22 device at mdio addr 1. Enable both so either RJ45
 * links (vendor image证实双口都在用).
 */
&gmac0 {
	phy-mode = "rmii";
	clock_in_out = "output";

	snps,reset-gpio = <&gpio0 RK_PA0 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	snps,reset-delays-us = <0 20000 100000>;

	pinctrl-names = "default";
	pinctrl-0 = <&eth_rmii0_miim_pins
		     &eth_rmii0_tx_bus2_pins
		     &eth_rmii0_rx_bus2_pins
		     &eth_rmii0_clk_pins>;

	phy-handle = <&rmii_phy0>;
	status = "okay";
};

&mdio0 {
	rmii_phy0: phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x1>;
	};
};

/*
 * gmac1 — second RJ45. SoC node + eth_rmii1 pinctrl in rk3506.dtsi; reset on
 * GPIO0_PC4.
 */
&gmac1 {
	phy-mode = "rmii";
	clock_in_out = "output";

	snps,reset-gpio = <&gpio0 RK_PC4 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	snps,reset-delays-us = <0 20000 100000>;

	pinctrl-names = "default";
	pinctrl-0 = <&eth_rmii1_miim_pins
		     &eth_rmii1_tx_bus2_pins
		     &eth_rmii1_rx_bus2_pins
		     &eth_rmii1_clk_pins>;

	phy-handle = <&rmii_phy1>;
	status = "okay";
};

&mdio1 {
	rmii_phy1: phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x1>;
	};
};

/*
 * MMC/SD (dw_mmc) — the SD card slot (ATK reference: rk3506b-alientek.dtsi).
 * Mainline dw_mmc-rockchip probes via the rk3288-dw-mshc fallback compatible.
 * Supplies are always-on fixed 3.3V rails (forge has no PMIC); card-detect on
 * GPIO0_PA2.
 */
&mmc {
	bus-width = <4>;
	cap-sd-highspeed;
	no-1-8-v;

	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc_clk_pins &sdmmc_cmd_pins &sdmmc_bus4_pins &sdmmc_det>;

	cd-gpios = <&gpio0 RK_PA2 GPIO_ACTIVE_LOW>;
	vmmc-supply = <&vcc3v3_sd>;
	vqmmc-supply = <&vccio_sd>;
	status = "okay";
};

/*
 * SPI0 — userspace spidev on CS0/CS1 (ATK reference: rk3506b-alientek.dtsi).
 * Mainline spi-rockchip probes via the rk3066-spi fallback. PIO (no DMA — the
 * vendor 5-cell DMA encoding doesn't bind mainline pl330). spidev children use
 * the whitelisted "rohm,dh2228fv" binding (mainline rejects "rockchip,spidev").
 */
&spi0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&spi0_csn0_pins &spi0_csn1_pins &spi0_clk_pins>;

	spidev@0 {
		compatible = "rohm,dh2228fv";
		spi-max-frequency = <50000000>;
		reg = <0>;
	};

	spidev@1 {
		compatible = "rohm,dh2228fv";
		spi-max-frequency = <50000000>;
		reg = <1>;
	};
};

/*
 * I2C0/1/2 + UART2 — reach the board via the RK3506 RMIO crossbar (rm_io pads).
 * The crossbar mux itself is in the pinctrl driver (RMIO patch); the pad groups
 * (rm_io13/14=i2c0, rm_io24/25=i1c1, rm_io4/5=i2c2, rm_io26/27=uart2) live in
 * rk3506.dtsi. i2c2 carries the GT911 capacitive touch (goodix, @0x14). PIO
 * only — no dmas (the vendor 5-cell DMA encoding doesn't bind mainline pl330).
 * Reference: vendor rk3506b-alientek.dtsi + rk3506-evb1-v10.dtsi (i2c2 pads).
 */
&i2c0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io13_i2c0_scl &rm_io14_i2c0_sda>;

	es8388: es8388@11 {
		compatible = "everest,es8388";
		reg = <0x11>;
		#sound-dai-cells = <0>;
		clocks = <&cru MCLK_OUT_SAI1>;
		clock-names = "mclk";
		/* es8328 set_sysclk accepts only 11.2896/12.288/22.5792/24.576 MHz (or 0);
		 * pin the sai1 mclk composite (MCLK_SAI1) to 12.288 MHz, else the codec
		 * rejects the default mclk rate with -EINVAL and the card won't probe. */
		assigned-clocks = <&cru MCLK_SAI1>;
		assigned-clock-rates = <12288000>;
		status = "okay";
	};
};

&i2c1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io24_i2c1_scl &rm_io25_i2c1_sda>;
};

&i2c2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io4_i2c2_scl &rm_io5_i2c2_sda>;

	touchscreen@14 {
		compatible = "goodix,gt911";
		reg = <0x14>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PA6 IRQ_TYPE_LEVEL_LOW>;
		irq-gpios = <&gpio0 RK_PA6 IRQ_TYPE_LEVEL_LOW>;
		reset-gpios = <&gpio0 RK_PA7 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};
};

&uart2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io26_uart2_tx &rm_io27_uart2_rx>;
};

/*
 * USB — both DWC2 controllers brought up as host (the board's USB-A carries the
 * WiFi dongle and any USB peripheral; host enumeration is the bring-up goal).
 * Mainline phy-rockchip-inno-usb2 drives the USB2PHY (analog tuning via its own
 * 0xff2b0000 mmio window + bvalid/id/ls detection via the GRF); dwc2 binds on
 * the snps,dwc2 fallback. Both ports enabled so whichever physical connector
 * the dongle lands on enumerates on the first flash; OTG/gadget is follow-up.
 *
 * The phy PROVIDER driver binds to the usb2phy PARENT node (the one carrying the
 * rk3506-usb2phy compatible); the otg-port/host-port children are the phys it
 * publishes. So the parent must be status="okay" too — enabling only the child
 * ports leaves the provider unprobed and dwc2 defers forever with "error
 * getting phy" (caught on the first board test, boot-sdl-202606200858).
 */
&usb2phy {
	status = "okay";
};

&u2phy_otg0 {
	status = "okay";
};

&u2phy_otg1 {
	status = "okay";
};

&usb20_otg0 {
	dr_mode = "host";
	status = "okay";
};

&usb20_otg1 {
	dr_mode = "host";
	status = "okay";
};

&sai1 {
	status = "okay";
};

/*
 * ES8388 audio: sai1 (I2S, stereo over sdo0) feeds the es8388 codec on i2c0.
 * Sound card is mainline simple-audio-card (vendor used the private
 * rockchip,multicodecs-card machine driver, rewritten here). mclk comes from
 * the cru MCLK_OUT_SAI1 gate; the sai1_mclk pinctrl routes it to the codec.
 * If mclk doesn't reach the codec (GRF to-IO gate not set), add the
 * rockchip,clk-out driver (Phase E follow-up). Reference: vendor
 * rk3502-evb1-v10.dtsi (sound card + es8388) + rk3506b-alientek.dtsi.
 */
/ {
	sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "rockchip-es8388";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <256>;

		simple-audio-card,cpu {
			sound-dai = <&sai1>;
		};

		simple-audio-card,codec {
			sound-dai = <&es8388>;
		};
	};
};

&pinctrl {
	sdmmc {
		/omit-if-no-ref/
		sdmmc_det: sdmmc-det {
			rockchip,pins =
				/* sdmmc_det */ <0 RK_PA2 1 &pcfg_pull_up>;
		};
	};
};

/ {
	vcc3v3_sd: vcc3v3-sd-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_sd";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	vccio_sd: vccio-sd-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vccio_sd";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};
};

/*
 * SPI-NAND (Winbond W25N04KV, 4Gb) on the SFC. Lets Linux see the NAND as MTD
 * + attach UBI for persistent rootfs (see notes/10). Partition layout mirrors
 * third_party/bringup/parameter-nand-aes.txt (512B-sector units → bytes, 128KB
 * erase-block aligned); the 0x0–0x400000 (0–4MB) loader/idblock area is left
 * unpartitioned. 50 MHz + DLL. Reads are reliable (230-cell window; ro reboot
 * loop clean). RW writes corrupted the page at ALL speeds (24/50/80 MHz) —
 * root cause was the SFC TX-FIFO level mask being 5-bit instead of RK3506's
 * 6-bit (GENMASK(13,8)), so write_fifo miscomputed free slots. Fixed in the
 * driver; this DT is back to the target 50 MHz.
 */
&sfc {
	status = "okay";

	flash@0 {
		compatible = "spi-nand";	/* W25N04KV; mainline winbond.c id (0xaa,0x23) */
		reg = <0>;
		spi-max-frequency = <80000000>;	/* vendor EVB speed (rk3506-evb2-v10). ATK ships at 50M.
						 * 100M unusable: clk_set_rate(100M) lands on 98M PLL tap, DLL finds no window.
						 * 80M -> 75M PLL tap, DLL ok (cell 130, window [90,170]).
						 * Loader weak write on rootfs PEB3/4 is covered by ubiprog first-boot rewrite. */
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <1>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@400000 {
				label = "uboot";
				reg = <0x400000 0x400000>;
			};
			partition@800000 {
				label = "misc";
				reg = <0x800000 0x100000>;
			};
			partition@900000 {
				label = "vnvm";
				reg = <0x900000 0x40000>;
			};
			partition@940000 {
				label = "recovery";
				reg = <0x940000 0xe00000>;
			};
			partition@1740000 {
				label = "boot";
				reg = <0x1740000 0x1000000>;
			};
			partition@2740000 {
				label = "rootfs";
				reg = <0x2740000 0xae00000>;
			};
			partition@d540000 {
				label = "userdata";
				reg = <0xd540000 0x12ac0000>;
			};
		};
	};
};
